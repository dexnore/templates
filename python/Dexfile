# syntax=dexnore/dexfile:0

# This Dockerfile uses Dexfile syntax. For more information, see:
# https://github.com/dexnore/dexfile

ARG PY_ENTRYPOINT=.
ARG PORT=3000
ARG BASE_IMAGE=python:3.12-slim
ARG APP_IMAGE=deps
ARG PIP=pip
ARG PIP_OPTS="--no-cache-dir --disable-pip-version-check --prefer-binary"
ARG POETRY_VERSION=1.8.1
ARG POETRY_HOME=/opt/poetry
ARG POETRY_VENV=/home/dexfile/.venv
ARG PIPENV_VENV_IN_PROJECT=1
ENV PIPENV_VENV_IN_PROJECT=${PIPENV_VENV_IN_PROJECT}
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV POETRY_HOME=${POETRY_HOME}
ENV POETRY_VENV=${POETRY_VENV}
ENV PATH="${POETRY_HOME}/bin:${POETRY_VENV}/bin:${PATH}"
ENV FLASK_APP=app.py
ENV FLASK_RUN_HOST=