# syntax=dexnore/dexfile:0

# This Dockerfile uses Dexfile syntax. For more information, see:
# https://github.com/dexnore/dexfile

ARG BUILD_IMAGE=node:lts-alpine
ARG PORT=3000
ARG APP_IMAGE=deps

CTR --mount=target=. base-img
    IF PROC [ ! -f "package.json" ]
        RUN echo "no 'package.json' file found!" >&2 && exit 1;
    ENDIF

    IF PROC ([ -f "bun.lockb" ] || [ -f "bun.lock" ]) && [ "node:lts-alpine" == "${BUILD_IMAGE}" ]
        ARG BUILD_IMAGE=oven/bun:alpine
    ELSEIF (PROC [ -f "lock.json" ] || [ -s "deno.json" ] || [ -s "deno.jsonc" ]) && [ "node:lts-alpine" == "${BUILD_IMAGE}" ]
        ARG BUILD_IMAGE=denoland/deno:alpine
    ENDIF

    IF PROC [ -f "nginx.conf" ]
        ARG APP_IMAGE=nginx:stable-alpine-slim
    ENDIF
ENDCTR

FROM ${BUILD_IMAGE} AS base
RUN addgroup dexnore && adduser --ingroup dexnore dexfile --disabled-password
WORKDIR /home/dexfile/app
USER dexfile:dexnore
ENV NODE_ENV=${NODE_ENV}


FROM base AS deps
ARG PM=npm
COPY --chown=dexfile:dexnore \
    package.json \
    package-lock.json* \
    yarn.lock* \
    pnpm-lock.yaml* \
    bun.lock* \
    lock.json* \
    deno.json* \
    bunfig.toml* \
    .npmrc* \
    .yarnrc.yml* \
    nginx.conf* \
    /home/dexfile/app/
RUN if [ -f "yarn.lock" ]; then \
        npm install -g yarn \
    elif [ -f "pnpm-lock.yaml" ]; then \
        npm install -g pnpm \
    fi;

IF RUN [ -f "yarn.lock" ]
    ARG PM=yarn
    RUN if [ -f "nx.json" ]; then yarn global add nx;
ELSEIF RUN [ -f "pnpm-lock.yaml" ]
    ARG PM=pnpm
    RUN if [ -f "nx.json" ]; then pnpm add --global nx;
ELSEIF RUN [ -f "bun.lockb" ] || [ -f "bun.lock" ]
    ARG PM=bun
    RUN if [ -f "nx.json" ]; then bun install --global nx;
ELSEIF RUN [ -f "lock.json" ] || [ -s "deno.json" ] || [ -s "deno.jsonc" ]
    ARG PM=deno
    RUN if [ -f "nx.json" ]; then deno install --global --allow-net --allow-read nx;
ELSE
    RUN if [ -f "nx.json" ]; then npm add --global nx;
ENDIF

FROM deps AS installer
RUN --mount=type=cache,target=. \
    --mount=type=secret,id=npmrc,target=.npmrc \
    --mount=type=secret,id=yarnrc,target=.yarnrc.yml \
    --mount=type=secret,id=bunfig,target=bunfig.toml \
    if [ -f "package-lock.json" ]; then \
        npm ci --omit=dev; \
    elif [ -f "yarn.lock" ]; then \
        yarn install --immutable --check-cache --production; \
    elif [ -f "pnpm-lock.yaml" ]; then \
        pnpm install --frozen-lockfile --production; \
    elif [ -f "bun.lockb" ] || [ -f "bun.lock" ]; then \
        bun install --fronzen-lock --production; \
    elif [ -f "lock.json" ] || [ -s "deno.json" ] || [ -s "deno.jsonc" ]; then \
        deno install --frozen --production --allow-net --allow-read; \
    else \
        npm ci --omit=dev; # assume file npm-shrinkwrap.json exists \
    fi;

FROM deps AS builder
RUN apk add --no-cache python3 git libc6-compat
COPY --from=installer --chown=dexfile:dexnore /home/dexfile/app/node_modules /home/dexfile/app/node_modules
COPY . /home/dexfile/app/
RUN if [ -f "yarn.lock" ]; then \
        yarn build; \
    elif [ -f "pnpm-lock.yaml" ]; then \
        pnpm run build; \
    elif [ -f "bun.lockb" ] || [ -f "bun.lock" ]; then \
        bun run build; \
    elif [ -f "lock.json" ] || [ -s "deno.json" ] || [ -s "deno.jsonc" ]; then \
        deno task build --frozen; \
    else \
        npm run build; \
    fi;

FROM ${APP_IMAGE} AS production
RUN addgroup dexnore && adduser --ingroup dexnore dexfile --disabled-password
WORKDIR /home/dexfile/app
USER dexfile:dexnore
ENV NODE_ENV=${NODE_ENV}
ENV PORT=${PORT}
EXPOSE ${PORT}/tcp
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
    CMD curl -f http://localhost:${PORT}/ || exit 1

IF PROC [ -f "nx.json" ] && [ ! -f "nginx.conf" ]
    COPY --chown=dexfile:dexnore --from=builder /home/dexfile/app/dist/apps/* /home/dexfile/app/
ELSEIF [ ! -f "nx.json" ] && [ ! -f "nginx.conf" ]
    COPY --chown=dexfile:dexnore --from=builder /home/dexfile/app /home/dexfile/app
ELSEIF [ ! -f "nx.json" ] && [ -f "nginx.conf" ]
    COPY --chown=root:root --from=builder /home/dexfile/app/* /usr/share/nginx/html
ELSE
    COPY --chown=root:root --from=builder /home/dexfile/app/dist/apps/* /usr/share/nginx/html
ENDIF

COPY --chown=root:root nginx.conf* /etc/nginx/conf.d/default.conf

CTR --mount=target=. base-img
    IF PROC [ -f "nginx.conf" ]
        ENTRYPOINT [ "nginx", "-g", "daemon off;" ]
    ELSEIF PROC [ -f "deno.json" ] || [ -f "deno.jsonc" ]
        ENTRYPOINT [ "deno", "task", "start" ]
    ELSE
        ENTRYPOINT [ "$PM", "run", "start" ]
    ENDIF
ENDCTR

# nginx:stable-alpine-slim
FROM production AS release
LABEL maintainer="@dexnore/dexfile"
